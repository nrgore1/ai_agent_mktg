-# Diagonal repeating "PROOF" overlay for watermarked share proofs. Slate
-# ink (not white) so it stays visible over the mostly-white page images.
-# Built here (not inside the .format template) so its braces/URL-encoding
-# don't collide with str.format escaping — it's injected as one value.
-def _watermark_block() -> str:
-    import urllib.parse
-
-    svg = (
-        '<svg xmlns="http://www.w3.org/2000/svg" width="320" height="220">'
-        '<text x="20" y="130" transform="rotate(-30 160 110)" '
-        'fill="rgba(71,85,105,0.32)" font-size="30" font-weight="700" '
