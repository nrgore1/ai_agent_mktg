+check('unsigned private object denied',unsigned_code==403)
+r=a.post('/api/export/share-book/',{'title':'Private preview','pages':[page],'watermark':True},format='json')
+check('real storage preview opens',r.status_code==200 and page.encode()in urllib.request.urlopen(r.json()['share_url'],timeout=10).read())
+check('anonymous library denied',anon.get('/api/memoirs/').status_code in (401,403))
+check('legacy export cannot bypass ownership',b.post(url+'export/',{},format='json').status_code==404)
+check('legacy export explicitly unavailable',a.post(url+'export/',{},format='json').status_code==410)
+r=fresh.post('/api/auth/logout/');check('logout revokes token',r.status_code==200 and fresh.get('/api/auth/me/').status_code in (401,403))
