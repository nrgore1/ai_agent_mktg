-@csrf_exempt
-def export_book_pdf(request):
-    """Print-grade multi-page book PDF.
-
-    Body:
-      {
-        "title": "...",
-        "size": {"w_in": 8, "h_in": 8},      # trim size in inches
-        "bleed_in": 0.125,                   # 0 for digital
-        "color_profile": "cmyk" | "rgb",     # cmyk = press-ready output
-        "pages": ["data:image/png;base64,...", ...]  # pre-rendered pages
-      }
-    → {"pdf_url": ..., "pages": N, "color_profile": "cmyk"|"rgb"}
-
-    Pages arrive as 300-DPI PNG renders from the studio; each is placed
-    contain-fit on the trim box (the studio page is square — non-square
-    trims letterbox until per-trim page sizes land). When cmyk is requested
-    the RGB PDF gets a Ghostscript DeviceCMYK pass.
-    """
-    from reportlab.lib.utils import ImageReader
-
-    data = json.loads(request.body.decode("utf-8"))
-    title = data.get("title", "Untitled Memoir")
-    size = data.get("size") or {}
-    w_in = float(size.get("w_in") or 8)
-    h_in = float(size.get("h_in") or 8)
-    bleed = float(data.get("bleed_in") or 0)
-    pages = data.get("pages") or []
-    if not pages:
-        return JsonResponse({"error": "no pages supplied"}, status=400)
-
-    pt = 72  # points per inch
-    page_w = (w_in + 2 * bleed) * pt
-    page_h = (h_in + 2 * bleed) * pt
-    trim_w = w_in * pt
-    trim_h = h_in * pt
-
-    buf = io.BytesIO()
-    pdf = canvas.Canvas(buf, pagesize=(page_w, page_h))
-    pdf.setTitle(title)
-
-    for page_data_url in pages:
-        try:
-            raw = base64.b64decode(page_data_url.split(",")[-1])
-            img = ImageReader(io.BytesIO(raw))
-            iw, ih = img.getSize()
-            # Contain-fit the (square) page render on the trim box, centered
-            # inside the bleed area.
-            scale = min(trim_w / iw, trim_h / ih)
-            dw, dh = iw * scale, ih * scale
-            x = bleed * pt + (trim_w - dw) / 2
-            y = bleed * pt + (trim_h - dh) / 2
-            pdf.drawImage(img, x, y, width=dw, height=dh)
-        except Exception as exc:  # noqa: BLE001 — skip a bad page, keep book
-            pdf.setFont("Helvetica", 10)
-            pdf.drawString(36, page_h / 2, f"[page failed to render: {exc}]")
-        pdf.showPage()
-
-    pdf.save()
-    buf.seek(0)
-    pdf_bytes = buf.read()
-
-    profile = "rgb"
-    want = (data.get("color_profile") or "").lower()
-    if want == "pdfx":
-        pdf_bytes, profile = _convert_pdf_to_pdfx(pdf_bytes)
-    elif want == "cmyk":
-        pdf_bytes, profile = _convert_pdf_to_cmyk(pdf_bytes)
-
-    object_name = f"exports/{uuid4()}.pdf"
-    pdf_url = upload_to_minio_signed(
-        pdf_bytes, object_name, content_type="application/pdf"
-    )
-    from memoir_api.audit.utils import log_event
-
-    log_event(
-        "export.book_pdf",
-        metadata={
-            "pages": len(pages),
-            "trim": f'{w_in}x{h_in}"',
-            "bleed_in": bleed,
-            "color_profile": profile,
-            "object": object_name,
-        },
-    )
-    return JsonResponse(
-        {"pdf_url": pdf_url, "pages": len(pages), "color_profile": profile}
-    )
-
