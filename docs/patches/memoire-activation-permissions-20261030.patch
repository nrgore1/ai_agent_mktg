+
+# Diagonal repeating "PROOF" overlay for watermarked share proofs. Slate
+# ink (not white) so it stays visible over the mostly-white page images.
+# Built here (not inside the .format template) so its braces/URL-encoding
+# don't collide with str.format escaping — it's injected as one value.
+def _watermark_block() -> str:
+    import urllib.parse
+
+    svg = (
+        '<svg xmlns="http://www.w3.org/2000/svg" width="320" height="220">'
+        '<text x="20" y="130" transform="rotate(-30 160 110)" '
+        'fill="rgba(71,85,105,0.32)" font-size="30" font-weight="700" '
+        'font-family="sans-serif" letter-spacing="4">PROOF</text></svg>'
+    )
+    uri = "data:image/svg+xml," + urllib.parse.quote(svg)
+    return (
+        f'<div style="position:absolute;inset:0;pointer-events:none;'
+        f"background-image:url('{uri}');background-repeat:repeat\"></div>"
+    )
+
+
+@api_view(["POST"])
+@permission_classes([IsAuthenticated])
+def export_share_book(request):
+    """Hosted flip-book share link.
+
+    Body: {"title": "...", "pages": ["data:image/png;base64,...", ...]}
+    → {"share_url": ...}
+
+    Builds a self-contained HTML viewer (pages embedded as data-URLs,
+    prev/next + arrow keys) and stores it in MinIO — one URL anyone can
+    open, nothing to install.
+    """
+    data = request.data
+    title = data.get("title", "My Memoir")
+    pages = data.get("pages") or []
+    watermark = bool(data.get("watermark", False))
+    if not pages:
+        return JsonResponse({"error": "no pages supplied"}, status=400)
+
+    html = SHARE_VIEWER_TEMPLATE.format(
+        title=title.replace("<", "&lt;"),
+        count=len(pages),
+        pages_json=json.dumps(pages),
+        watermark_block=_watermark_block() if watermark else "",
+    )
+    object_name = f"shares/{uuid4()}.html"
+    share_url = upload_to_minio_signed(
+        html.encode("utf-8"), object_name, content_type="text/html"
+    )
+    from memoir_api.audit.utils import log_event
+
+    log_event(
+        "share.flipbook",
+        metadata={
+            "pages": len(pages),
+            "title": title[:80],
+            "object": object_name,
+            "watermark": watermark,
+        },
+    )
+    return JsonResponse(
+        {"share_url": share_url, "pages": len(pages), "watermark": watermark}
+    )
+
+
+@api_view(["POST"])
+@permission_classes([IsAuthenticated])
+def export_magazine(request):
+    data = request.data
+    html = f"""
+    <html><head><title>{data.get('title','Memoir Magazine')}</title></head>
+    <body><h1>{data.get('title','Memoir')}</h1><p>Magazine export successful.</p></body></html>
+    """
+    file_bytes = html.encode("utf-8")
+    object_name = f"{uuid4()}.html"
+    magazine_url = upload_to_minio_signed(file_bytes, object_name, content_type="text/html")
+    return JsonResponse({"magazine_url": magazine_url})
