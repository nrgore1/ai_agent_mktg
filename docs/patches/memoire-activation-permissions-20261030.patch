+def _build_epub(title, author, pages, cover_image=None):
+    """Build a valid EPUB 3 file with optional cover image + TOC."""
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as zf:
+        # required mimetype file (must be first, uncompressed)
+        zf.writestr("mimetype", "application/epub+zip", compress_type=zipfile.ZIP_STORED)
+
+        # META-INF/container.xml
+        zf.writestr(
+            "META-INF/container.xml",
+            """<?xml version="1.0"?>
+<container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container">
+  <rootfiles>
+    <rootfile full-path="OEBPS/content.opf" media-type="application/oebps-package+xml"/>
+  </rootfiles>
+</container>""",
+        )
+
+        # CSS
+        zf.writestr(
+            "OEBPS/style.css",
+            "body { font-family: Georgia, serif; margin: 2em; } h1 { color: #333; } img.cover { width: 100%; height: auto; }"
+        )
+
+        manifest_items = []
+        spine_items = []
+        toc_entries = []
+
+        # Optional cover image
+        if cover_image:
+            try:
+                image_data = base64.b64decode(cover_image.split(",")[-1])
+                zf.writestr("OEBPS/cover.jpg", image_data)
+                cover_html = '<img src="cover.jpg" alt="Cover" class="cover"/>'
+                manifest_items.append('<item id="cover-image" href="cover.jpg" media-type="image/jpeg" properties="cover-image"/>')
+            except Exception:
+                cover_html = ""
+        else:
+            cover_html = ""
+
+        # Build page content
+        for idx, page in enumerate(pages or [], start=1):
+            body_html = ""
+            for obj in page.get("objects", []):
+                if obj.get("type") == "text":
+                    body_html += f"<p>{obj.get('text')}</p>\n"
+            if not body_html:
+                body_html = "<p>(Empty Page)</p>"
+            filename = f"OEBPS/page{idx}.xhtml"
+            html = EPUB_TEMPLATE.format(title=f"Page {idx}", body=body_html)
+            zf.writestr(filename, html)
+            manifest_items.append(f'<item id="page{idx}" href="page{idx}.xhtml" media-type="application/xhtml+xml"/>')
+            spine_items.append(f'<itemref idref="page{idx}"/>')
+            toc_entries.append(f'<li><a href="page{idx}.xhtml">Page {idx}</a></li>')
+
+        # Table of Contents page
+        toc_html = f"""
+<html xmlns="http://www.w3.org/1999/xhtml"><head><title>Table of Contents</title>
+<link rel="stylesheet" type="text/css" href="style.css"/></head>
+<body><h1>Table of Contents</h1><ul>{''.join(toc_entries)}</ul></body></html>"""
+        zf.writestr("OEBPS/toc.xhtml", toc_html)
+        manifest_items.append('<item id="toc" href="toc.xhtml" media-type="application/xhtml+xml" properties="nav"/>')
+        spine_items.insert(0, '<itemref idref="toc"/>')
+
+        # Main content.opf
+        opf = f"""<?xml version="1.0" encoding="utf-8"?>
+<package version="3.0" xmlns="http://www.idpf.org/2007/opf" unique-identifier="BookId">
+  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
+    <dc:title>{title}</dc:title>
+    <dc:creator>{author}</dc:creator>
+    <dc:language>en</dc:language>
+    <dc:date>{datetime.utcnow().isoformat()}</dc:date>
+    <meta property="dcterms:modified">{datetime.utcnow().isoformat()}</meta>
+  </metadata>
+  <manifest>
+    {' '.join(manifest_items)}
+    <item id="style" href="style.css" media-type="text/css"/>
+  </manifest>
+  <spine>
+    {' '.join(spine_items)}
+  </spine>
+</package>"""
+        zf.writestr("OEBPS/content.opf", opf)
+
+        # Optional cover.xhtml
+        if cover_html:
+            cover_page = f"""<html xmlns="http://www.w3.org/1999/xhtml"><head><title>Cover</title></head>
+<body>{cover_html}</body></html>"""
+            zf.writestr("OEBPS/cover.xhtml", cover_page)
+            manifest_items.append('<item id="cover" href="cover.xhtml" media-type="application/xhtml+xml"/>')
+            spine_items.insert(0, '<itemref idref="cover"/>')
+
+    return buf.getvalue()
+
