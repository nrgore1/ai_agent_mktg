+from django.shortcuts import get_object_or_404, render
+from django.utils.decorators import method_decorator
+from django.views.decorators.csrf import csrf_exempt
+from django.db.models import Q
+from rest_framework import viewsets, permissions
+from rest_framework.authentication import TokenAuthentication
+from rest_framework.decorators import action, api_view, permission_classes
+from rest_framework.response import Response
+from rest_framework.exceptions import APIException
+from django.http import Http404
+from .models import MemoirProject
+from .serializers import MemoirProjectSerializer
+
+class AllowAnyPermissions(permissions.BasePermission):
+    def has_permission(self, request, view): return True
+    def has_object_permission(self, request, view, obj): return True
+
+@method_decorator(csrf_exempt, name="dispatch")
+class MemoirViewSet(viewsets.ModelViewSet):
+    serializer_class = MemoirProjectSerializer
+    # Respect the configured token/JWT authentication and require an account.
+    # Public examples are served through the separate showcase endpoint.
+    permission_classes = [permissions.IsAuthenticated]
+    queryset = MemoirProject.objects.all().order_by("-updated_at")
+
+    def get_queryset(self):
+        """Signed-in users see their own books plus unclaimed (legacy)
+        ones; anonymous requests keep full dev-open visibility. Archived
+        books are hidden unless ?archived=1 (only) or ?all=1 (both)."""
+        from .tenant import visible_projects
+
+        qs = MemoirProject.objects.all().order_by("-updated_at")
+        user = getattr(self.request, "user", None)
+        # Tenant scoping: dev-open by default (own + unclaimed), or strict
+        # org-scoped when TENANT_STRICT=1. See memoirs/tenant.py.
+        qs = visible_projects(qs, user)
+        # Showcase example books are ownerless (so they read as "unclaimed")
+        # but must never appear in a user's own library — hide them here; they
+        # are served only via /api/showcase/. Detail actions still reach them
+        # so a clone can read the source by pk.
+        # NB: NULL-safe on purpose — a bare .exclude(meta__showcase=True)
+        # compiles to NOT(meta->'showcase' = true), which is NULL (i.e. also
+        # excluded) for every book that simply lacks the key, emptying the
+        # whole library.
+        if getattr(self, "action", None) == "list":
+            qs = qs.filter(
+                Q(meta__showcase__isnull=True) | Q(meta__showcase=False)
+            )
+        # Only the LIST view hides archived books — detail actions (retrieve/
+        # rename/unarchive/delete) must still reach an archived project.
+        if getattr(self, "action", None) == "list":
+            params = getattr(self.request, "query_params", self.request.GET)
+            if params.get("archived") in ("1", "true"):
+                qs = qs.filter(archived=True)
+            elif params.get("all") not in ("1", "true"):
+                qs = qs.filter(archived=False)
+        return qs
+
+    def perform_update(self, serializer):
+        """Saving an unclaimed book while signed in claims it."""
+        user = getattr(self.request, "user", None)
+        instance = serializer.instance
+        if (
+            user is not None
+            and user.is_authenticated
+            and instance is not None
+            and instance.owner_id is None
+        ):
+            serializer.save(owner=user)
+        else:
+            serializer.save()
+
+    def create(self, request, *args, **kwargs):
+        try:
+            return super().create(request, *args, **kwargs)
+        except (APIException, Http404):
+            raise
+        except Exception:
+            return Response({"error": "create_failed"}, status=400)
+
+    def update(self, request, *args, **kwargs):
+        try:
+            return super().update(request, *args, **kwargs)
+        except (APIException, Http404):
+            raise
+        except Exception:
+            return Response({"error": "update_failed"}, status=400)
+
+    def perform_create(self, serializer):
+        owner = self.request.user if getattr(self.request, "user", None) and self.request.user.is_authenticated else None
+        serializer.save(owner=owner)
+
+    @action(detail=True, methods=["post"])
+    def export(self, request, pk=None):
+        # This legacy job queue has no implementation. Authorize the object
+        # first, then direct supported clients to the explicit export route.
+        self.get_object()
+        return Response({"error": "legacy_export_unavailable",
+                         "export_endpoint": "/api/export/book-pdf/"}, status=410)
+
+@api_view(["GET"])
+@permission_classes([AllowAnyPermissions])
+def export_status(request, job_id):
+    return Response(get_export_status(job_id), status=200)
+
+# PUBLIC pages
+def editor(request):   return render(request, "memoirs/editor.html")
+def projects(request): return render(request, "memoirs/projects.html")
+def workbench(request):return render(request, "workbench/backlog.html")
+# memoir_api/memoirs/views.py
+
+from django.views.decorators.csrf import csrf_exempt
+from django.http import JsonResponse, HttpResponseBadRequest
+from .utils import convert_heic_to_jpeg  # make sure this function exists and works
+
+@csrf_exempt
+def convert_heic(request):
+    if request.method == 'POST' and request.FILES.get('file'):
+        try:
+            file = request.FILES['file']
+            url = convert_heic_to_jpeg(file)  # Your own utility that saves file and returns URL
+            return JsonResponse({'image_url': url})
+        except Exception as e:
+            return JsonResponse({'error': 'conversion_failed', 'detail': str(e)}, status=500)
+    return JsonResponse({'error': 'Invalid request method or missing file'}, status=400)
