-def _convert_pdf_to_cmyk(pdf_bytes: bytes) -> tuple[bytes, str]:
-    """Ghostscript DeviceCMYK pass over an RGB PDF.
-
-    Returns (pdf_bytes, profile) where profile is "cmyk" on success or
-    "rgb" when Ghostscript is unavailable/fails — the book still exports,
-    the response just says so.
-    """
-    import shutil
-    import subprocess
-    import tempfile
-
-    gs = shutil.which("gs")
-    if not gs:
-        return pdf_bytes, "rgb"
-    with tempfile.TemporaryDirectory() as tmp:
-        src = os.path.join(tmp, "in.pdf")
-        dst = os.path.join(tmp, "out.pdf")
-        with open(src, "wb") as fh:
-            fh.write(pdf_bytes)
-        try:
-            subprocess.run(
-                [
-                    gs,
-                    "-dSAFER",
-                    "-dBATCH",
-                    "-dNOPAUSE",
-                    "-sDEVICE=pdfwrite",
-                    "-dProcessColorModel=/DeviceCMYK",
-                    "-sColorConversionStrategy=CMYK",
-                    "-dDownsampleColorImages=false",
-                    f"-sOutputFile={dst}",
-                    src,
-                ],
-                check=True,
-                capture_output=True,
-                timeout=300,
-            )
-            with open(dst, "rb") as fh:
-                return fh.read(), "cmyk"
-        except Exception:  # noqa: BLE001 — fall back to RGB, never fail the book
-            return pdf_bytes, "rgb"
-
-
-def _find_cmyk_icc() -> str | None:
-    """Locate a CMYK ICC profile Ghostscript can embed as the output intent."""
-    import glob
-
-    candidates = [
-        "/usr/share/color/icc/default_cmyk.icc",
-        "/usr/share/color/icc/ghostscript/default_cmyk.icc",
-    ]
-    candidates += sorted(
-        glob.glob("/usr/share/ghostscript/*/iccprofiles/default_cmyk.icc"),
-        reverse=True,
-    )
-    for path in candidates:
-        if os.path.exists(path):
-            return path
-    return None
-
