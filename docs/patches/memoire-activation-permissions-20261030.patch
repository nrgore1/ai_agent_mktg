+def _convert_pdf_to_cmyk(pdf_bytes: bytes) -> tuple[bytes, str]:
+    """Ghostscript DeviceCMYK pass over an RGB PDF.
+
+    Returns (pdf_bytes, profile) where profile is "cmyk" on success or
+    "rgb" when Ghostscript is unavailable/fails — the book still exports,
+    the response just says so.
+    """
+    import shutil
+    import subprocess
+    import tempfile
+
+    gs = shutil.which("gs")
+    if not gs:
+        return pdf_bytes, "rgb"
+    with tempfile.TemporaryDirectory() as tmp:
+        src = os.path.join(tmp, "in.pdf")
+        dst = os.path.join(tmp, "out.pdf")
+        with open(src, "wb") as fh:
+            fh.write(pdf_bytes)
+        try:
+            subprocess.run(
+                [
+                    gs,
+                    "-dSAFER",
+                    "-dBATCH",
+                    "-dNOPAUSE",
+                    "-sDEVICE=pdfwrite",
+                    "-dProcessColorModel=/DeviceCMYK",
+                    "-sColorConversionStrategy=CMYK",
+                    "-dDownsampleColorImages=false",
+                    f"-sOutputFile={dst}",
+                    src,
+                ],
+                check=True,
+                capture_output=True,
+                timeout=300,
+            )
+            with open(dst, "rb") as fh:
+                return fh.read(), "cmyk"
+        except Exception:  # noqa: BLE001 — fall back to RGB, never fail the book
+            return pdf_bytes, "rgb"
+
+
+def _find_cmyk_icc() -> str | None:
+    """Locate a CMYK ICC profile Ghostscript can embed as the output intent."""
+    import glob
+
+    candidates = [
+        "/usr/share/color/icc/default_cmyk.icc",
+        "/usr/share/color/icc/ghostscript/default_cmyk.icc",
+    ]
+    candidates += sorted(
+        glob.glob("/usr/share/ghostscript/*/iccprofiles/default_cmyk.icc"),
+        reverse=True,
+    )
+    for path in candidates:
+        if os.path.exists(path):
+            return path
+    return None
+
+
+# pdfmark definition that attaches a PDF/X-1a output intent to the document.
+# {PROFILE} is the (tmp-dir-local) ICC filename; {COND} the print condition.
+_PDFX_DEF = """%!
+/ICCProfile ({PROFILE}) def
+[ /GTS_PDFXVersion (PDF/X-1a:2001) /DOCINFO pdfmark
+[ /_objdef {{icc_PDFX}} /type /stream /OBJ pdfmark
+[ {{icc_PDFX}} << /N 4 >> /PUT pdfmark
+[ {{icc_PDFX}} ICCProfile (r) file /PUT pdfmark
+[ /_objdef {{OutputIntent_PDFX}} /type /dict /OBJ pdfmark
+[ {{OutputIntent_PDFX}} <<
+  /Type /OutputIntent
+  /S /GTS_PDFX
+  /OutputCondition ({COND})
+  /OutputConditionIdentifier ({COND})
+  /RegistryName (http://www.color.org)
+  /DestOutputProfile {{icc_PDFX}}
+>> /PUT pdfmark
+[ {{Catalog}} << /OutputIntents [ {{OutputIntent_PDFX}} ] >> /PUT pdfmark
+"""
+
+
+def _convert_pdf_to_pdfx(pdf_bytes: bytes) -> tuple[bytes, str]:
+    """Ghostscript PDF/X-1a:2001 pass — CMYK + an embedded output intent.
+
+    PDF/X is what commercial printers ask for: everything converted to a
+    single CMYK output condition with the ICC profile embedded so colour is
+    unambiguous. Returns (bytes, "pdfx") on success, else falls back to a
+    plain CMYK pass, else RGB — the book always exports.
+    """
+    import shutil
+    import subprocess
+    import tempfile
+
+    gs = shutil.which("gs")
+    icc = _find_cmyk_icc()
+    if not gs or not icc:
+        return _convert_pdf_to_cmyk(pdf_bytes)
+
+    with tempfile.TemporaryDirectory() as tmp:
+        src = os.path.join(tmp, "in.pdf")
+        dst = os.path.join(tmp, "out.pdf")
+        # Copy the ICC into the tmp dir so -dSAFER permits reading it.
+        prof = os.path.join(tmp, "cmyk.icc")
+        shutil.copyfile(icc, prof)
+        defps = os.path.join(tmp, "PDFX_def.ps")
+        with open(src, "wb") as fh:
+            fh.write(pdf_bytes)
+        with open(defps, "w") as fh:
+            fh.write(_PDFX_DEF.format(PROFILE=prof, COND="CGATS TR 001 (SWOP)"))
+        try:
+            subprocess.run(
+                [
+                    gs,
+                    "-dPDFX",
+                    "-dBATCH",
+                    "-dNOPAUSE",
+                    "-dNOOUTERSAVE",
+                    "-dSAFER",
+                    # SAFER (gs 10.x) blocks reading the ICC unless permitted.
+                    f"--permit-file-read={prof}",
+                    "-sDEVICE=pdfwrite",
+                    "-dProcessColorModel=/DeviceCMYK",
+                    "-sColorConversionStrategy=CMYK",
+                    "-dPDFACompatibilityPolicy=1",
+                    "-dDownsampleColorImages=false",
+                    f"-sOutputFile={dst}",
+                    defps,
+                    src,
+                ],
+                check=True,
+                capture_output=True,
+                timeout=300,
+                cwd=tmp,
+            )
+            with open(dst, "rb") as fh:
+                out = fh.read()
+            # Only claim PDF/X if the intent actually landed.
+            if b"/GTS_PDFX" in out or b"OutputIntent" in out:
+                return out, "pdfx"
+            return out, "cmyk"
+        except Exception:  # noqa: BLE001 — fall back, never fail the book
+            return _convert_pdf_to_cmyk(pdf_bytes)
+
+
+@api_view(["POST"])
+@permission_classes([IsAuthenticated])
+def export_book_pdf(request):
+    """Print-grade multi-page book PDF.
+
+    Body:
+      {
+        "title": "...",
+        "size": {"w_in": 8, "h_in": 8},      # trim size in inches
+        "bleed_in": 0.125,                   # 0 for digital
+        "color_profile": "cmyk" | "rgb",     # cmyk = press-ready output
+        "pages": ["data:image/png;base64,...", ...]  # pre-rendered pages
+      }
+    → {"pdf_url": ..., "pages": N, "color_profile": "cmyk"|"rgb"}
+
+    Pages arrive as 300-DPI PNG renders from the studio; each is placed
+    contain-fit on the trim box (the studio page is square — non-square
+    trims letterbox until per-trim page sizes land). When cmyk is requested
+    the RGB PDF gets a Ghostscript DeviceCMYK pass.
+    """
+    from reportlab.lib.utils import ImageReader
+
+    data = request.data
+    title = data.get("title", "Untitled Memoir")
+    size = data.get("size") or {}
+    w_in = float(size.get("w_in") or 8)
+    h_in = float(size.get("h_in") or 8)
+    bleed = float(data.get("bleed_in") or 0)
+    pages = data.get("pages") or []
+    if not pages:
+        return JsonResponse({"error": "no pages supplied"}, status=400)
+
+    pt = 72  # points per inch
+    page_w = (w_in + 2 * bleed) * pt
+    page_h = (h_in + 2 * bleed) * pt
+    trim_w = w_in * pt
+    trim_h = h_in * pt
+
+    buf = io.BytesIO()
+    pdf = canvas.Canvas(buf, pagesize=(page_w, page_h))
+    pdf.setTitle(title)
+
+    for page_data_url in pages:
+        try:
+            raw = base64.b64decode(page_data_url.split(",")[-1])
+            img = ImageReader(io.BytesIO(raw))
+            iw, ih = img.getSize()
+            # Contain-fit the (square) page render on the trim box, centered
+            # inside the bleed area.
+            scale = min(trim_w / iw, trim_h / ih)
+            dw, dh = iw * scale, ih * scale
+            x = bleed * pt + (trim_w - dw) / 2
+            y = bleed * pt + (trim_h - dh) / 2
+            pdf.drawImage(img, x, y, width=dw, height=dh)
+        except Exception as exc:  # noqa: BLE001 — skip a bad page, keep book
+            pdf.setFont("Helvetica", 10)
+            pdf.drawString(36, page_h / 2, f"[page failed to render: {exc}]")
+        pdf.showPage()
+
+    pdf.save()
+    buf.seek(0)
+    pdf_bytes = buf.read()
+
+    profile = "rgb"
+    want = (data.get("color_profile") or "").lower()
+    if want == "pdfx":
+        pdf_bytes, profile = _convert_pdf_to_pdfx(pdf_bytes)
+    elif want == "cmyk":
+        pdf_bytes, profile = _convert_pdf_to_cmyk(pdf_bytes)
+
+    object_name = f"exports/{uuid4()}.pdf"
+    pdf_url = upload_to_minio_signed(
+        pdf_bytes, object_name, content_type="application/pdf"
+    )
+    from memoir_api.audit.utils import log_event
+
+    log_event(
+        "export.book_pdf",
+        metadata={
+            "pages": len(pages),
+            "trim": f'{w_in}x{h_in}"',
+            "bleed_in": bleed,
+            "color_profile": profile,
+            "object": object_name,
+        },
+    )
+    return JsonResponse(
+        {"pdf_url": pdf_url, "pages": len(pages), "color_profile": profile}
+    )
+
+
+def _render_book_pdf(title, pages, w_in, h_in, bleed, color_profile="rgb"):
+    """Render a list of page data-URLs into a single print-grade PDF.
+
+    color_profile: "rgb" (default), "cmyk", or "pdfx" (PDF/X-1a output intent).
+    Returns (pdf_bytes, color_profile). Shared by export_book_pdf and the
+    multi-volume export so both produce identical page geometry.
+    """
+    from reportlab.lib.utils import ImageReader
+
+    pt = 72
+    page_w = (w_in + 2 * bleed) * pt
+    page_h = (h_in + 2 * bleed) * pt
+    trim_w = w_in * pt
+    trim_h = h_in * pt
+
+    buf = io.BytesIO()
+    pdf = canvas.Canvas(buf, pagesize=(page_w, page_h))
+    pdf.setTitle(title)
+    for page_data_url in pages:
+        try:
+            raw = base64.b64decode(page_data_url.split(",")[-1])
+            img = ImageReader(io.BytesIO(raw))
+            iw, ih = img.getSize()
+            scale = min(trim_w / iw, trim_h / ih)
+            dw, dh = iw * scale, ih * scale
+            x = bleed * pt + (trim_w - dw) / 2
+            y = bleed * pt + (trim_h - dh) / 2
+            pdf.drawImage(img, x, y, width=dw, height=dh)
+        except Exception as exc:  # noqa: BLE001 — skip a bad page, keep book
+            pdf.setFont("Helvetica", 10)
+            pdf.drawString(36, page_h / 2, f"[page failed to render: {exc}]")
+        pdf.showPage()
+    pdf.save()
+    buf.seek(0)
+    pdf_bytes = buf.read()
+
+    profile = "rgb"
+    if color_profile == "pdfx":
+        pdf_bytes, profile = _convert_pdf_to_pdfx(pdf_bytes)
+    elif color_profile == "cmyk":
+        pdf_bytes, profile = _convert_pdf_to_cmyk(pdf_bytes)
+    return pdf_bytes, profile
+
+
+@api_view(["POST"])
+@permission_classes([IsAuthenticated])
+def export_volumes(request):
+    """Split one project into several print-ready mini-books (one PDF each).
+
+    A long life story often reads better as a boxed set — one slim volume per
+    event ("The Wedding", "Honeymoon", "First Year") — than as a single heavy
+    tome. This takes the same 300-DPI page renders as export_book_pdf and cuts
+    them into volumes, returning a PDF URL per volume plus a combined page count.
+
+    Body (either form):
+      A) explicit volumes:
+         {"volumes": [{"title": "Vol I", "pages": ["data:...", ...]}, ...], ...}
+      B) split a flat page list at break indices:
+         {"pages": ["data:...", ...], "breaks": [4, 9],
+          "volume_titles": ["Wedding", "Honeymoon", "First Year"], ...}
+
+    Shared print options: size {w_in,h_in}, bleed_in, color_profile "cmyk"|"rgb".
+    → {"volumes": [{"title","pages","pdf_url","color_profile"}, ...],
+        "count": N, "total_pages": M}
+    """
+    data = request.data
+    book_title = data.get("title", "Untitled Memoir")
+    size = data.get("size") or {}
+    w_in = float(size.get("w_in") or 8)
+    h_in = float(size.get("h_in") or 8)
+    bleed = float(data.get("bleed_in") or 0)
+    color_profile = (data.get("color_profile") or "rgb").lower()
+
+    # Normalize both request forms into a list of {title, pages}.
+    volumes = data.get("volumes")
+    if not volumes:
+        pages = data.get("pages") or []
+        if not pages:
+            return JsonResponse({"error": "no pages supplied"}, status=400)
+        breaks = sorted(
+            i for i in (data.get("breaks") or []) if 0 < int(i) < len(pages)
+        )
+        titles = data.get("volume_titles") or []
+        cuts = [0] + [int(b) for b in breaks] + [len(pages)]
+        volumes = []
+        for vi in range(len(cuts) - 1):
+            seg = pages[cuts[vi]:cuts[vi + 1]]
+            if not seg:
+                continue
+            vtitle = titles[vi] if vi < len(titles) else f"Volume {vi + 1}"
+            volumes.append({"title": vtitle, "pages": seg})
+
+    if not volumes:
+        return JsonResponse({"error": "no volumes to export"}, status=400)
+
+    out = []
+    total_pages = 0
+    for vi, vol in enumerate(volumes, start=1):
+        vpages = vol.get("pages") or []
+        if not vpages:
+            continue
+        vtitle = vol.get("title") or f"Volume {vi}"
+        full_title = f"{book_title} — {vtitle}"
+        pdf_bytes, profile = _render_book_pdf(
+            full_title, vpages, w_in, h_in, bleed, color_profile
+        )
+        object_name = f"exports/volumes/{uuid4()}.pdf"
+        pdf_url = upload_to_minio_signed(
+            pdf_bytes, object_name, content_type="application/pdf"
+        )
+        total_pages += len(vpages)
+        out.append({
+            "title": vtitle,
+            "pages": len(vpages),
+            "pdf_url": pdf_url,
+            "color_profile": profile,
+        })
+
+    from memoir_api.audit.utils import log_event
+
+    log_event(
+        "export.volumes",
+        metadata={
+            "volumes": len(out),
+            "total_pages": total_pages,
+            "trim": f'{w_in}x{h_in}"',
+            "color_profile": color_profile,
+        },
+    )
+    return JsonResponse(
+        {"volumes": out, "count": len(out), "total_pages": total_pages}
+    )
+
+
+SHARE_VIEWER_TEMPLATE = """<!doctype html>
+<html><head><meta charset="utf-8"/>
+<meta name="viewport" content="width=device-width, initial-scale=1"/>
+<title>{title}</title>
