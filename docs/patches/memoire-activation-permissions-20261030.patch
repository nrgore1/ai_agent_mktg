-# pdfmark definition that attaches a PDF/X-1a output intent to the document.
-# {PROFILE} is the (tmp-dir-local) ICC filename; {COND} the print condition.
-_PDFX_DEF = """%!
-/ICCProfile ({PROFILE}) def
-[ /GTS_PDFXVersion (PDF/X-1a:2001) /DOCINFO pdfmark
-[ /_objdef {{icc_PDFX}} /type /stream /OBJ pdfmark
-[ {{icc_PDFX}} << /N 4 >> /PUT pdfmark
-[ {{icc_PDFX}} ICCProfile (r) file /PUT pdfmark
-[ /_objdef {{OutputIntent_PDFX}} /type /dict /OBJ pdfmark
-[ {{OutputIntent_PDFX}} <<
-  /Type /OutputIntent
-  /S /GTS_PDFX
-  /OutputCondition ({COND})
-  /OutputConditionIdentifier ({COND})
-  /RegistryName (http://www.color.org)
-  /DestOutputProfile {{icc_PDFX}}
->> /PUT pdfmark
-[ {{Catalog}} << /OutputIntents [ {{OutputIntent_PDFX}} ] >> /PUT pdfmark
-"""
-
-
-def _convert_pdf_to_pdfx(pdf_bytes: bytes) -> tuple[bytes, str]:
-    """Ghostscript PDF/X-1a:2001 pass — CMYK + an embedded output intent.
-
-    PDF/X is what commercial printers ask for: everything converted to a
-    single CMYK output condition with the ICC profile embedded so colour is
-    unambiguous. Returns (bytes, "pdfx") on success, else falls back to a
-    plain CMYK pass, else RGB — the book always exports.
-    """
-    import shutil
-    import subprocess
-    import tempfile
-
-    gs = shutil.which("gs")
-    icc = _find_cmyk_icc()
-    if not gs or not icc:
-        return _convert_pdf_to_cmyk(pdf_bytes)
-
-    with tempfile.TemporaryDirectory() as tmp:
-        src = os.path.join(tmp, "in.pdf")
-        dst = os.path.join(tmp, "out.pdf")
-        # Copy the ICC into the tmp dir so -dSAFER permits reading it.
-        prof = os.path.join(tmp, "cmyk.icc")
-        shutil.copyfile(icc, prof)
-        defps = os.path.join(tmp, "PDFX_def.ps")
-        with open(src, "wb") as fh:
-            fh.write(pdf_bytes)
-        with open(defps, "w") as fh:
-            fh.write(_PDFX_DEF.format(PROFILE=prof, COND="CGATS TR 001 (SWOP)"))
-        try:
-            subprocess.run(
-                [
-                    gs,
-                    "-dPDFX",
-                    "-dBATCH",
-                    "-dNOPAUSE",
-                    "-dNOOUTERSAVE",
-                    "-dSAFER",
-                    # SAFER (gs 10.x) blocks reading the ICC unless permitted.
-                    f"--permit-file-read={prof}",
-                    "-sDEVICE=pdfwrite",
-                    "-dProcessColorModel=/DeviceCMYK",
-                    "-sColorConversionStrategy=CMYK",
-                    "-dPDFACompatibilityPolicy=1",
-                    "-dDownsampleColorImages=false",
-                    f"-sOutputFile={dst}",
-                    defps,
-                    src,
-                ],
-                check=True,
-                capture_output=True,
-                timeout=300,
-                cwd=tmp,
-            )
-            with open(dst, "rb") as fh:
-                out = fh.read()
-            # Only claim PDF/X if the intent actually landed.
-            if b"/GTS_PDFX" in out or b"OutputIntent" in out:
-                return out, "pdfx"
-            return out, "cmyk"
-        except Exception:  # noqa: BLE001 — fall back, never fail the book
-            return _convert_pdf_to_cmyk(pdf_bytes)
-
