-@csrf_exempt
-def export_volumes(request):
-    """Split one project into several print-ready mini-books (one PDF each).
-
-    A long life story often reads better as a boxed set — one slim volume per
-    event ("The Wedding", "Honeymoon", "First Year") — than as a single heavy
-    tome. This takes the same 300-DPI page renders as export_book_pdf and cuts
-    them into volumes, returning a PDF URL per volume plus a combined page count.
-
-    Body (either form):
-      A) explicit volumes:
-         {"volumes": [{"title": "Vol I", "pages": ["data:...", ...]}, ...], ...}
-      B) split a flat page list at break indices:
-         {"pages": ["data:...", ...], "breaks": [4, 9],
-          "volume_titles": ["Wedding", "Honeymoon", "First Year"], ...}
-
-    Shared print options: size {w_in,h_in}, bleed_in, color_profile "cmyk"|"rgb".
-    → {"volumes": [{"title","pages","pdf_url","color_profile"}, ...],
-        "count": N, "total_pages": M}
-    """
-    data = json.loads(request.body.decode("utf-8"))
-    book_title = data.get("title", "Untitled Memoir")
-    size = data.get("size") or {}
-    w_in = float(size.get("w_in") or 8)
-    h_in = float(size.get("h_in") or 8)
-    bleed = float(data.get("bleed_in") or 0)
-    color_profile = (data.get("color_profile") or "rgb").lower()
-
-    # Normalize both request forms into a list of {title, pages}.
-    volumes = data.get("volumes")
-    if not volumes:
-        pages = data.get("pages") or []
-        if not pages:
-            return JsonResponse({"error": "no pages supplied"}, status=400)
-        breaks = sorted(
-            i for i in (data.get("breaks") or []) if 0 < int(i) < len(pages)
-        )
-        titles = data.get("volume_titles") or []
-        cuts = [0] + [int(b) for b in breaks] + [len(pages)]
-        volumes = []
-        for vi in range(len(cuts) - 1):
-            seg = pages[cuts[vi]:cuts[vi + 1]]
-            if not seg:
-                continue
-            vtitle = titles[vi] if vi < len(titles) else f"Volume {vi + 1}"
-            volumes.append({"title": vtitle, "pages": seg})
-
-    if not volumes:
-        return JsonResponse({"error": "no volumes to export"}, status=400)
-
-    out = []
-    total_pages = 0
-    for vi, vol in enumerate(volumes, start=1):
-        vpages = vol.get("pages") or []
-        if not vpages:
-            continue
-        vtitle = vol.get("title") or f"Volume {vi}"
-        full_title = f"{book_title} — {vtitle}"
-        pdf_bytes, profile = _render_book_pdf(
-            full_title, vpages, w_in, h_in, bleed, color_profile
-        )
-        object_name = f"exports/volumes/{uuid4()}.pdf"
-        pdf_url = upload_to_minio_signed(
-            pdf_bytes, object_name, content_type="application/pdf"
-        )
-        total_pages += len(vpages)
-        out.append({
-            "title": vtitle,
-            "pages": len(vpages),
-            "pdf_url": pdf_url,
-            "color_profile": profile,
-        })
-
-    from memoir_api.audit.utils import log_event
-
-    log_event(
-        "export.volumes",
-        metadata={
-            "volumes": len(out),
-            "total_pages": total_pages,
-            "trim": f'{w_in}x{h_in}"',
-            "color_profile": color_profile,
-        },
-    )
-    return JsonResponse(
-        {"volumes": out, "count": len(out), "total_pages": total_pages}
-    )
