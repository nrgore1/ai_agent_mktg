+++ b/services/api-django/memoir_api/memoirs/privacy_client.py
@@ -0,0 +1,41 @@
+"""Server-only, product-scoped privacy link. Never accepts caller-supplied email."""
+import hashlib
+import hmac
+import json
+import os
+import time
+import urllib.request
+
+
+class PrivacyUnavailable(RuntimeError):
+    pass
+
+
+def privacy_call(brand, email, event_id, operation):
+    key = os.environ.get("AGENTVIRE_PRIVACY_KEY", "")
+    service = os.environ.get("AGENTVIRE_PRIVACY_SERVICE", "")
+    if not key:
+        if os.environ.get("AGENTVIRE_PRIVACY_REQUIRED") == "true":
+            raise PrivacyUnavailable("Privacy connection unavailable; deletion was not completed. Please retry.")
+        return {"status": "not_connected"}
+    if len(key) < 32 or not service:
+        raise PrivacyUnavailable("Privacy connection is not configured")
+    path = "/internal/marketing/account"
+    payload = {"brand": brand, "email": email.strip().lower(), "event_id": str(event_id), "operation": operation}
+    body = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    stamp = str(time.time())
+    message = "\n".join([service, stamp, "POST", path, hashlib.sha256(body).hexdigest()])
+    signature = hmac.new(key.encode(), message.encode(), hashlib.sha256).hexdigest()
+    url = os.environ.get("AGENTVIRE_PRIVACY_URL", "http://growthpilot-agentvire:8098") + path
+    request = urllib.request.Request(url, data=body, headers={
+        "Content-Type": "application/json", "X-Privacy-Service": service,
+        "X-Privacy-Time": stamp, "X-Privacy-Signature": signature,
+    })
+    try:
+        with urllib.request.urlopen(request, timeout=15) as response:
+            result = json.loads(response.read(131072))
+        if result.get("status") not in {"erased", "verification_required", "exported"}:
+            raise ValueError("Unexpected privacy response")
+        return result
+    except Exception as exc:
+        raise PrivacyUnavailable("Privacy connection unavailable; deletion was not completed. Please retry.") from exc
