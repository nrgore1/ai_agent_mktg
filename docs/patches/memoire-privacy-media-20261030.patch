@@ -0,0 +1,36 @@
+"""Read-only gate for an isolated restored database; never changes live accounts."""
+import os
+
+
+def check():
+    service = os.environ['AGENTVIRE_PRIVACY_SERVICE']
+    if service == 'weddingos':
+        import asyncio, uuid
+        from weddingos_api.privacy_journal import records, verify_checkpoint
+        from weddingos_api.database import SessionFactory
+        from weddingos_api.platform_models import UserAccount
+        async def run():
+            pending=0
+            async with SessionFactory() as session:
+                for row in records('accounts'):
+                    user=await session.get(UserAccount,uuid.UUID(row['subject']))
+                    if user is not None and user.status != 'deleted':pending+=1
+            return pending
+        verify_checkpoint()
+        pending=asyncio.run(run())
+    else:
+        from django.contrib.auth import get_user_model
+        if service == 'jodibana':
+            from jodii_core.services.privacy_journal import records, verify_checkpoint
+        else:
+            from memoir_api.memoirs.privacy_journal import records, verify_checkpoint
+        verify_checkpoint()
+        pending=0
+        for row in records('accounts'):
+            user=get_user_model().objects.filter(pk=row['subject']).first()
+            if user is None:continue
+            identity=user.date_joined.isoformat() if service=='jodibana' else str(user.uuid)
+            if identity == row['identity']:pending+=1
+    return {'service':service,'account_reconciliation_pending':pending,
+            'may_reopen_accounts':pending==0,
+            'media_and_provider_review_required':True}
