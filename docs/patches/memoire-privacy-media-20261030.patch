@@ -0,0 +1,55 @@
+"""Exact FileField cleanup for an already-authorized account deletion.
+
+Shared storage references are retained. Failures stop the database deletion so
+the request can be retried; object deletion is idempotent. Never follows URLs.
+"""
+from django.apps import apps
+from django.db import models
+from django.db.models.deletion import Collector
+
+
+def collect(roots):
+    collector = Collector(using="default")
+    for obj in roots:
+        collector.collect([obj])
+    objects = [(model, list(rows)) for model, rows in collector.data.items()]
+    objects.extend((qs.model, list(qs)) for qs in collector.fast_deletes)
+    removed = {}
+    for model, rows in objects:
+        removed.setdefault(model, set()).update(x.pk for x in rows)
+    targets = []
+    seen = set()
+    for model, rows in objects:
+        for field in model._meta.fields:
+            if not isinstance(field, models.FileField): continue
+            for obj in rows:
+                value = getattr(obj, field.name)
+                if not value or (model._meta.label, field.name, value.name) in seen: continue
+                seen.add((model._meta.label, field.name, value.name))
+                targets.append((field.storage, value.name, model._meta.label, field.name))
+    return targets, removed
+
+
+def references(targets):
+    return [{"model": label, "field": field, "name": name} for _, name, label, field in targets]
+
+
+def cleanup(targets, removed, validate):
+    result = {"deleted": 0, "shared_retained": 0}
+    for storage, name, _, _ in targets:
+        validate(name)
+        shared = False
+        for model in apps.get_models():
+            for field in model._meta.fields:
+                if isinstance(field, models.FileField):
+                    # Conservatively retain an exact reference even across different backends.
+                    qs = model._default_manager.filter(**{field.name: name})
+                    if model in removed: qs = qs.exclude(pk__in=removed[model])
+                    if qs.exists(): shared = True; break
+            if shared: break
+        if shared:
+            result["shared_retained"] += 1; continue
+        storage.delete(name)
+        if storage.exists(name): raise RuntimeError("Media deletion has not completed")
+        result["deleted"] += 1
+    return result
