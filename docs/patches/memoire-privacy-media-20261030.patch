diff --git a/services/api-django/memoir_api/memoirs/owned_media.py b/services/api-django/memoir_api/memoirs/owned_media.py
new file mode 100644
index 000000000..3824e7fb4
--- /dev/null
+++ b/services/api-django/memoir_api/memoirs/owned_media.py
@@ -0,0 +1,53 @@
+"""Owner-bound object writes and retryable account cleanup."""
+from contextvars import ContextVar
+from functools import wraps
+import uuid
+from django.contrib.auth import get_user_model
+from rest_framework.response import Response
+from .privacy_journal import subject_lock, records, write, valid_name
+
+owner = ContextVar("media_owner", default=None)
+
+def owned_request(view):
+    @wraps(view)
+    def call(request, *args, **kwargs):
+        subject = str(request.user.uuid)
+        with subject_lock(subject):
+            if not get_user_model().objects.filter(pk=request.user.pk, uuid=subject, is_active=True).exists():
+                return Response({"error":"account_unavailable"}, status=403)
+            if any(r["identity"] == subject for r in records("accounts")):
+                return Response({"error":"account_deletion_pending"}, status=409)
+            token = owner.set(subject)
+            try: return view(request, *args, **kwargs)
+            finally: owner.reset(token)
+    return call
+
+def register_object(name, backend, bucket):
+    subject = owner.get()
+    if subject is None:
+        # Legacy/background writers need separate ownership integration.
+        return name
+    suffix = name.rsplit(".", 1)[-1].lower()
+    suffix = suffix if suffix.isalnum() and len(suffix) <= 10 else "bin"
+    key = "owned/" + subject + "/" + uuid.uuid4().hex + "." + suffix
+    write("objects", key, {"subject":subject,"name":key,"backend":backend,"bucket":bucket})
+    return key
+
+def references(subject):
+    return [r for r in records("objects") if r["subject"] == str(subject)]
+
+def cleanup(subject):
+    from . import utils_storage as storage
+    count = 0
+    for item in references(subject):
+        name = valid_name(item["name"])
+        if not name.startswith("owned/" + str(subject) + "/") or item["backend"] != storage.BACKEND or item["bucket"] != storage.BUCKET_NAME:
+            raise RuntimeError("Object ownership or backend needs review")
+        if storage.BACKEND == "minio":
+            storage._minio().remove_object(storage.BUCKET_NAME, name)
+        else:
+            from google.api_core.exceptions import NotFound
+            try: storage._gcs_bucket().blob(name).delete()
+            except NotFound: pass
+        count += 1
+    return count
diff --git a/services/api-django/memoir_api/memoirs/privacy_journal.py b/services/api-django/memoir_api/memoirs/privacy_journal.py
new file mode 100644
index 000000000..7fd1010ff
--- /dev/null
+++ b/services/api-django/memoir_api/memoirs/privacy_journal.py
@@ -0,0 +1,128 @@
+"""Signed, durable privacy recovery evidence, stored outside application databases.
+
+Contains opaque account identifiers and exact storage references, never email.
+The journal is a recovery dependency, not a claim that provider history is erased.
+"""
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path, PurePosixPath
+import tempfile
+from contextlib import contextmanager
+from datetime import datetime, timezone
+
+
+def root():
+    folder = os.getenv("PRIVACY_RECOVERY_DIR")
+    if not folder:
+        raise RuntimeError("Privacy recovery storage is not configured")
+    path = Path(folder)
+    path.mkdir(parents=True, exist_ok=True, mode=0o700)
+    return path
+
+
+def key():
+    value = os.getenv("PRIVACY_RECOVERY_KEY") or os.getenv("AGENTVIRE_PRIVACY_KEY", "")
+    if len(value) < 32:
+        raise RuntimeError("Privacy recovery signing key is not configured")
+    return value.encode()
+
+
+def digest(value):
+    return hmac.new(key(), value.encode(), hashlib.sha256).hexdigest()
+
+
+def valid_name(name):
+    p = PurePosixPath(name)
+    if not name or p.is_absolute() or ".." in p.parts or "\\" in name or ":" in name or "\x00" in name:
+        raise ValueError("Unsafe storage reference")
+    return name
+
+
+def write(kind, ident, payload):
+    folder = root() / kind
+    folder.mkdir(mode=0o700, exist_ok=True)
+    data = dict(payload, kind=kind, service=os.getenv("AGENTVIRE_PRIVACY_SERVICE", ""))
+    raw = json.dumps(data, sort_keys=True, separators=(",", ":"))
+    body = json.dumps({"data": data, "signature": digest(raw)})
+    target = folder / (digest(kind + ":" + ident) + ".json")
+    fd, temporary = tempfile.mkstemp(dir=folder, prefix=".pending-")
+    try:
+        with os.fdopen(fd, "w") as stream:
+            stream.write(body); stream.flush(); os.fsync(stream.fileno())
+        os.replace(temporary, target)
+        directory = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
+        try: os.fsync(directory)
+        finally: os.close(directory)
+    finally:
+        if os.path.exists(temporary): os.unlink(temporary)
+    return target
+
+
+def records(kind):
+    for path in sorted((root() / kind).glob("*.json")):
+        envelope = json.loads(path.read_text())
+        data = envelope["data"]
+        raw = json.dumps(data, sort_keys=True, separators=(",", ":"))
+        if not hmac.compare_digest(envelope["signature"], digest(raw)) or data["kind"] != kind or data["service"] != os.getenv("AGENTVIRE_PRIVACY_SERVICE", ""):
+            raise RuntimeError("Privacy recovery journal failed verification")
+        yield data
+
+
+@contextmanager
+def subject_lock(subject):
+    import fcntl
+    folder = root() / "locks"; folder.mkdir(mode=0o700, exist_ok=True)
+    fd = os.open(folder / digest(str(subject)), os.O_CREAT | os.O_RDWR, 0o600)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX)
+        yield
+    finally:
+        fcntl.flock(fd, fcntl.LOCK_UN); os.close(fd)
+
+
+def account_request(subject, identity, media):
+    # Preserve the earliest request and all media references across retries.
+    previous = next((r for r in records("accounts") if r["subject"] == str(subject)), None)
+    combined = {json.dumps(r, sort_keys=True): r for r in (previous or {}).get("media", []) + media}
+    return write("accounts", str(subject), {"subject": str(subject), "identity": str(identity),
+        "requested_at": (previous or {}).get("requested_at", datetime.now(timezone.utc).isoformat()),
+        "media": list(combined.values()), "provider_history": "scope_review_required"})
+
+
+def checkpoint(destination):
+    """Export after pausing account/media writes; retain separately from DB backups."""
+    import shutil
+    target = Path(destination)
+    target.mkdir(mode=0o700, parents=True, exist_ok=False)
+    try:
+        for kind in ('accounts', 'objects'):
+            list(records(kind))  # reject damaged signatures before copying
+        hashes = {}
+        for kind in ('accounts', 'objects'):
+            for path in (root()/kind).glob('*.json'):
+                if path.is_symlink(): raise RuntimeError('Unexpected journal symlink')
+                data = path.read_bytes(); name = kind+'/'+path.name
+                copied=target/name;copied.parent.mkdir(mode=0o700,exist_ok=True)
+                copied.write_bytes(data);copied.chmod(0o600)
+                hashes[name]=hashlib.sha256(data).hexdigest()
+        data={'created_at':datetime.now(timezone.utc).isoformat(),'files':hashes,
+              'service':os.environ['AGENTVIRE_PRIVACY_SERVICE']}
+        envelope={'data':data,'signature':digest(json.dumps(data,sort_keys=True))}
+        p=target/'checkpoint.json';p.write_text(json.dumps(envelope));p.chmod(0o600)
+        return {'journal_files':len(hashes)}
+    except Exception:
+        shutil.rmtree(target);raise
+
+
+def verify_checkpoint():
+    envelope=json.loads((root()/'checkpoint.json').read_text());data=envelope['data']
+    if not hmac.compare_digest(envelope['signature'],digest(json.dumps(data,sort_keys=True))):
+        raise RuntimeError('Recovery checkpoint signature failed')
+    age=(datetime.now(timezone.utc)-datetime.fromisoformat(data['created_at'])).total_seconds()
+    if data['service']!=os.environ['AGENTVIRE_PRIVACY_SERVICE'] or not -60<=age<=3600:
+        raise RuntimeError('A fresh checkpoint for this product is required')
+    actual={str(p.relative_to(root())):hashlib.sha256(p.read_bytes()).hexdigest()
+            for kind in ('accounts','objects')for p in (root()/kind).glob('*.json')}
+    if actual!=data['files']:raise RuntimeError('Recovery journal is incomplete or damaged')
